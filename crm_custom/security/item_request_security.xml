<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="item_request_line_company_rule" model="ir.rule">
        <field name="name">Item Request Line multi-company</field>
        <field name="model_id" ref="model_item_request_line"/>
        <field name="domain_force">[('lead_id.company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="item_request_line_personal_rule" model="ir.rule">
        <field name="name">Personal Item Request Lines</field>
        <field name="model_id" ref="model_item_request_line"/>
        <field name="domain_force">['|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="item_request_line_all_leads_rule" model="ir.rule">
        <field name="name">All Item Request Lines</field>
        <field name="model_id" ref="model_item_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
